# ===================================================================
# BACKTOBASE MEGA EVENT — ROOT CONFIGURATION REFERENCE
# ===================================================================

# --- BACKEND (Render / Node.js) ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/backtobase?retryWrites=true&w=majority
FRONTEND_URL=https://backtobase-event.vercel.app
PUBLIC_APP_URL=https://backtobase-event.vercel.app
JWT_SECRET=generate-a-strong-32-byte-hex-string-for-production
SESSION_SECRET=generate-a-strong-32-byte-hex-string-for-production
# Administrator Account Credentials
ADMIN_USERNAME=-admin
ADMIN_PASSWORD=-admin@backtobase
RESEND_API_KEY=re_123456789
EMAIL_FROM=BacktoBase Tickets <tickets@yourverifieddomain.com>

# --- FRONTEND (Vercel / Vite) ---
VITE_API_BASE_URL=https://backtobase-api.onrender.com/api
