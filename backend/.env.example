# BacktoBase Mega Event — Environment Configuration Example

# Server Environment
PORT=5000
NODE_ENV=development

# Database Configuration (Leave empty to use embedded in-memory MongoDB for local dev/testing)
# For production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.mongodb.net/backtobase?retryWrites=true&w=majority
MONGODB_URI=

# Frontend Client URL (For CORS policies)
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Authentication & Session Secrets
JWT_SECRET=super-secure-backtobase-secret-key-change-in-production-2026
SESSION_SECRET=super-secure-backtobase-secret-key-change-in-production-2026

# Administrator Account Initial Configuration
ADMIN_USERNAME=-admin
ADMIN_PASSWORD=-admin@backtobase

# Transactional Email Service (Resend)
# Leave empty to run in simulated email delivery mode during testing/dev
RESEND_API_KEY=
EMAIL_FROM=BacktoBase Tickets <tickets@backtobase.com>
